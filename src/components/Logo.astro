---
// Geçici metin logo: logo dosyası gelince bu bileşen SVG logoyla değiştirilecek.
interface Props {
  acik?: boolean;
}
const { acik = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--acik': acik }]} aria-label="Ay Peyzaj ve Çiçekçilik — Ana Sayfa">
  <span class="logo__ay">Ay</span>
  <span class="logo__alt">
    <span>PEYZAJ</span>
    <span>ÇİÇEKÇİLİK</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--yesil-700);
  }
  .logo__ay {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 2.3rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .logo__alt {
    display: flex;
    flex-direction: column;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.25;
    border-left: 2px solid var(--sari-500);
    padding-left: 0.45rem;
  }
  .logo--acik {
    color: #fff;
  }
</style>
